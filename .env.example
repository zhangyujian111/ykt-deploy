# 部署环境变量（不要提交到 git）
#
# 拷贝本文件为 .env 并填入实际值：
#   cp .env.example .env
#
# deploy.sh 会自动加载 .env。

# ============ \u963f\u91cc\u4e91 ACR \u914d\u7f6e ============
# ACR \u5730\u57df\u5730\u5740\uff08\u670d\u52a1\u5668\u4e0e ACR \u540c\u5730\u57df\u5185\u7f51\u62c9\u53d6\u514d\u6d41\u91cf\u8d39\uff09
ALIYUN_ACR_REGISTRY=registry.cn-hangzhou.aliyuncs.com
ALIYUN_ACR_NAMESPACE=ykt
ALIYUN_ACR_USERNAME=your_aliyun_account_id
ALIYUN_ACR_PASSWORD=your_acr_fixed_password

# ============ MySQL \u6839\u5bc6\u7801\uff08\u4e1a\u52a1\u5355\u5e93 ykt\uff09============
MYSQL_ROOT_PASSWORD=change_me_to_strong_password

# ============ Redis \u5bc6\u7801 ============
REDIS_PASSWORD=change_me_to_strong_password

# ============ \u57df\u540d\uff08\u7528\u4e8e\u670d\u52a1\u95f4\u8c03\u7528\u4e0e\u524d\u7aef\u8bbf\u95ee\uff09============
# \u5982\u679c\u670d\u52a1\u5668\u6ca1\u6709\u7ed1\u5b9a\u57df\u540d\uff0c\u8bf7\u7559\u7a7a\u4f7f\u7528 IP\uff0c\u6216\u8005\u5728 /etc/hosts \u4e2d\u914d\u7f6e\u672c\u5730\u89e3\u6790\u3002
PUBLIC_HOST=your.domain.com

# ============ LLM \u63a5\u5165\u70b9\uff08ykt-aisaas \u9700\u8981\uff09============
# \u6839\u636e\u5b9e\u9645\u63a5\u5165\u7684 LLM \u5382\u5546\u586b\u5165\uff0c\u793a\u4f8b\u4e3a DashScope
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus

# ============ PostgreSQL + pgvector\uff08RAG \u5411\u91cf\u68c0\u7d22\uff09============
POSTGRES_PASSWORD=change_me_to_strong_password
POSTGRES_DB=ykt_rag
